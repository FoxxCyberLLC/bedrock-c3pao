# Bedrock C3PAO — deployment configuration
#
# The container stores all instance configuration (API URL, instance key,
# AUTH_SECRET, and C3PAO identity) in PostgreSQL. These are created on first run
# via the web-based setup wizard at https://<host>:3001 — you do NOT set them here.
#
# The only value you may want to override is the bundled Postgres password.
# Copy this file to `.env` (next to docker-compose.yml) and change it before
# deploying anywhere reachable.

# Password for the bundled `db` (PostgreSQL) container. It is used by both the
# db service and the C3PAO container's DATABASE_URL. Defaults to `c3pao` if unset.
C3PAO_DB_PASSWORD=change-me

# Deploy:
#   cp .env.example .env   # then edit C3PAO_DB_PASSWORD
#   docker compose up -d
# Then open https://<host>:3001 and complete the setup wizard.
