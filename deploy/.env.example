# Bedrock C3PAO — deployment configuration
#
# Most instance configuration (API URL, instance key, AUTH_SECRET, and C3PAO
# identity) is created on first run via the web-based setup wizard at
# https://<host>:3001 and stored in PostgreSQL — you do NOT set those here.
#
# Copy this file to `.env` (next to docker-compose.yml) and set the values
# below before deploying anywhere reachable.

# Password for the bundled `db` (PostgreSQL) container. Used by both the db
# service and the C3PAO container's DATABASE_URL. Defaults to `c3pao` if unset.
C3PAO_DB_PASSWORD=change-me

# REQUIRED. Encryption key for sensitive config (AUTH_SECRET, INSTANCE_API_KEY)
# stored in the app_config table. Must be 32 bytes, hex or base64. The setup
# wizard CANNOT store config without this — set it before first run, and keep
# it stable across restarts (rotating it makes existing encrypted config
# unreadable). Generate one with:
#   openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# Only needed if you point DATABASE_URL at an EXTERNAL Postgres whose URL uses
# sslmode= (the bundled `db` runs plaintext on the internal compose network, so
# you can leave this blank for the default deployment). When sslmode is present,
# the server certificate is verified against this CA and the connection FAILS
# CLOSED if it is missing — paste the PEM CA chain here.
#   MIGRATION NOTE: deployments that previously ran sslmode=require without a CA
#   (unverified TLS) must provision DATABASE_CA_CERT before upgrading, or the
#   container will refuse to connect.
DATABASE_CA_CERT=

# Deploy:
#   cp .env.example .env                       # then edit the values above
#   # CONFIG_ENCRYPTION_KEY is mandatory: openssl rand -base64 32
#   docker compose up -d
# Then open https://<host>:3001 and complete the setup wizard.
